---
import type { PageDefinition } from "../data/pages";

const { page } = Astro.props as { page: PageDefinition };
const language = page.language ?? "en";
const isGerman = language === "de";
const casePath = isGerman ? "/de/fallstudie/" : "/case-study/";
const home = isGerman ? "/de/" : "/";
---

<aside class="rebuild-strip" aria-labelledby="rebuild-strip-title">
  <div class="shell rebuild-strip__inner">
    <div>
      <p class="kicker">{isGerman ? "Öffentliche Fallstudie" : "Public case study"}</p>
      <h2 id="rebuild-strip-title">{isGerman ? "Diese erworbene Domain wurde transparent neu aufgebaut." : "This acquired domain was rebuilt in public."}</h2>
      <p>{isGerman ? "Sieh dir die URL-Entscheidungen, technischen Prüfungen und die offengelegte Rolle von Contextter an." : "See the URL decisions, technical checks and Contextter's disclosed role."}</p>
    </div>
    <a class="btn btn--primary" href={casePath}>{isGerman ? "Fallstudie ansehen" : "Read the case study"} <span class="btn__arrow" aria-hidden="true">→</span></a>
  </div>
</aside>

<footer class="site-footer" data-od-id="site-footer">
  <div class="shell">
    <div class="site-footer__grid site-footer__grid--simple">
      <div>
        <a class="wordmark" href={home}><span class="wordmark__ns">PC::</span>PerlCoders</a>
        <p class="small muted" style="margin-top:var(--s-3);max-width:40ch">{isGerman ? "Praktische Hilfe für langlebige Perl- und CGI-Systeme. Neue Publikation unter neuer Inhaberschaft seit 2026." : "Practical help for long-lived Perl and CGI systems. A new publication under new ownership since 2026."}</p>
      </div>
      <nav aria-labelledby="f-main"><h2 id="f-main">{isGerman ? "Starten" : "Start"}</h2><ul><li><a href={isGerman ? "/de/anleitungen/" : "/guides/"}>{isGerman ? "Anleitungen" : "Guides"}</a></li><li><a href={isGerman ? "/de/werkzeuge/url-mapper/" : "/labs/legacy-url-mapper/"}>{isGerman ? "URL-Werkzeug" : "URL tool"}</a></li><li><a href={casePath}>{isGerman ? "Fallstudie" : "Case study"}</a></li></ul></nav>
      <nav aria-labelledby="f-more"><h2 id="f-more">{isGerman ? "Mehr" : "More"}</h2><ul><li><a href="/archive/">{isGerman ? "Historisches Archiv" : "Historical archive"}</a></li><li><a href="/about/">{isGerman ? "Über uns & Offenlegung" : "About & disclosure"}</a></li><li><a href="/contribute/#correction">{isGerman ? "Korrektur melden" : "Submit a correction"}</a></li><li><a href="https://github.com/lia-xim/perlcoders.com" rel="noopener noreferrer">GitHub</a></li></ul></nav>
    </div>
    <nav class="site-footer__legalnav" aria-label={isGerman ? "Rechtliches" : "Legal"}><a href="/legal-notice/">{isGerman ? "Impressum" : "Legal notice"}</a><a href="/privacy/">{isGerman ? "Datenschutz" : "Privacy"}</a><a href="/cookies/">Cookies</a><a href="/accessibility/">{isGerman ? "Barrierefreiheit" : "Accessibility"}</a></nav>
    <div class="site-footer__legal"><span>© <span data-year>2026</span> PerlCoders</span><span>{isGerman ? "Nicht mit dem früheren Unternehmen PerlCoders oder einer offiziellen Perl-Organisation verbunden." : "Not affiliated with the former PerlCoders company or any official Perl organisation."}</span></div>
  </div>
</footer>
