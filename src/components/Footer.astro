---
import type { PageDefinition } from "../data/pages";

const { page } = Astro.props as { page: PageDefinition };
const language = page.language ?? "en";
const isGerman = language === "de";
const casePath = language === "de" ? "/de/fallstudie/" : "/case-study/";
const privacyPath = isGerman ? "/de/datenschutz/" : "/privacy/";
const cookiesPath = isGerman ? "/de/cookies/" : "/cookies/";
---

<aside class="rebuild-strip" aria-labelledby="rebuild-strip-title">
  <div class="shell rebuild-strip__inner">
    <div>
      <p class="kicker">{language === "de" ? "Öffentlicher Fallbericht" : "Public case study"}</p>
      <h2 id="rebuild-strip-title">{language === "de" ? "Wie diese erworbene Domain ehrlich neu aufgebaut wurde" : "How this acquired domain was rebuilt without pretending to be its former owner"}</h2>
      <p>{language === "de" ? "Die Fallstudie zeigt URL-Entscheidungen, technische Prüfungen und die Grenzen der historischen Nutzung. Crawl Foundry wird dort als Plattform des gemeinsamen Eigentümers transparent genannt." : "See the URL decisions, technical checks, and historical boundaries behind the relaunch. Crawl Foundry is disclosed there as a platform under the same ownership."}</p>
    </div>
    <a class="btn btn--dark" href={casePath}>{language === "de" ? "Fallstudie lesen" : "Read the case study"} <span aria-hidden="true">→</span></a>
  </div>
</aside>

<footer class="site-footer" data-od-id="site-footer">
  <div class="shell">
    <div class="site-footer__grid">
      <div>
        <a class="wordmark" href={isGerman ? "/de/" : "/"}><span class="wordmark__ns">PC::</span>PerlCoders</a>
        <p class="small muted" style="margin-top:var(--s-3);max-width:34ch">{language === "de" ? "Praktische Perl-Anleitungen, nachvollziehbare Modernisierung und kleine Werkzeuge für langlebige Websysteme." : "Stories, working code, language decisions and web-automation experiments — from CGI and CPAN to current Perl and modern search engineering."}</p>
      </div>
      <nav aria-labelledby="f-sections"><h2 id="f-sections">{isGerman ? "Bereiche" : "Sections"}</h2><ul>{isGerman ? <><li><a href="/de/anleitungen/">Anleitungen</a></li><li><a href="/de/werkzeuge/url-mapper/">URL-Werkzeug</a></li><li><a href="/de/fallstudie/">Fallstudie</a></li><li><a href="/archive/">Historisches Archiv</a></li></> : <><li><a href="/now/">Now</a></li><li><a href="/rescue/">Rescue</a></li><li><a href="/timeline/">Timeline</a></li><li><a href="/compare/">Compare</a></li><li><a href="/labs/">Labs</a></li><li><a href="/archive/">Archive</a></li><li><a href="/pulse/">Pulse</a></li></>}</ul></nav>
      <nav aria-labelledby="f-take-part"><h2 id="f-take-part">{isGerman ? "Mitmachen" : "Take part"}</h2><ul><li><a href="/contribute/#ask">{isGerman ? "Frage stellen" : "Ask a question"}</a></li><li><a href="/contribute/#correction">{isGerman ? "Korrektur melden" : "Submit a correction"}</a></li><li><a href="/contribute/#artifact">{isGerman ? "Fundstück einreichen" : "Submit an artifact"}</a></li><li><a href="/code-of-conduct/">{isGerman ? "Verhaltenskodex" : "Code of conduct"}</a></li><li><a href="https://github.com/lia-xim/perlcoders.com" rel="noopener noreferrer">GitHub</a></li></ul></nav>
      <nav aria-labelledby="f-publication"><h2 id="f-publication">Publikation</h2><ul><li><a href="/about/">{isGerman ? "Über uns & Offenlegung" : "About & disclosure"}</a></li><li><a href="/editorial-policy/">{isGerman ? "Redaktionelle Regeln" : "Editorial policy"}</a></li><li><a href="/search/">{isGerman ? "Suche" : "Search"}</a></li><li><a href="/feed.xml">Atom feed</a></li></ul></nav>
    </div>
    <nav class="site-footer__legalnav" aria-label={isGerman ? "Rechtliches" : "Legal"}><a href="/legal-notice/">{isGerman ? "Impressum" : "Legal notice"}</a><a href={privacyPath}>{isGerman ? "Datenschutz" : "Privacy"}</a><a href="/terms/">{isGerman ? "Bedingungen" : "Terms"}</a><a href={cookiesPath}>Cookies</a><a href="/accessibility/">{isGerman ? "Barrierefreiheit" : "Accessibility"}</a></nav>
    <div class="site-footer__legal"><span>© <span data-year>2026</span> PerlCoders</span><span>{isGerman ? "Unabhängige Publikation, 2026 unter neuer Inhaberschaft neu gestartet." : "Independent publication, relaunched 2026 under new ownership."}</span><span>{isGerman ? "Nicht mit dem früheren Unternehmen PerlCoders oder einer offiziellen Perl-Organisation verbunden." : "Not affiliated with the former PerlCoders company or with any official Perl organisation."}</span></div>
    <p class="eof" aria-hidden="true"><b>EOF</b> {isGerman ? "statischer Build · cookiefreie Statistik · Quellen direkt verlinkt" : "static build · cookie-free analytics · sources linked in place"}</p>
    <div style="padding-block:var(--s-3) var(--s-6)"><a class="mono" style="color:var(--c-paper-muted);text-decoration-color:transparent" href="#main">{isGerman ? "Nach oben ↑" : "Back to top ↑"}</a></div>
  </div>
</footer>
