---
import type { PageDefinition } from "../data/pages";

const { page } = Astro.props as { page: PageDefinition };
const pathname = page.path;
const language = page.language ?? "en";
const sections = language === "de" ? [
  ["/de/anleitungen/", "Anleitungen"],
  ["/de/werkzeuge/url-mapper/", "URL-Werkzeug"],
  ["/de/fallstudie/", "Fallstudie"]
] as const : [
  ["/guides/", "Guides"],
  ["/labs/legacy-url-mapper/", "URL tool"],
  ["/case-study/", "Case study"]
] as const;
const home = language === "de" ? "/de/" : "/";
const languagePath = page.alternatePath ?? (language === "de" ? "/" : "/de/");
const active = (href: string) => pathname.startsWith(href);
---

<a class="skip" href="#main">{language === "de" ? "Zum Inhalt" : "Skip to content"}</a>
<header class="site-nav" data-od-id="site-header">
  <div class="shell site-nav__bar">
    <a class="wordmark" href={home} aria-label={language === "de" ? "PerlCoders — Startseite" : "PerlCoders — home"}><span class="wordmark__ns">PC::</span>PerlCoders</a>
    <nav class="site-nav__primary" aria-label={language === "de" ? "Hauptnavigation" : "Primary navigation"}>
      {sections.map(([href, label]) => <a class="navlink" aria-current={active(href) ? "page" : undefined} href={href}>{label}</a>)}
    </nav>
    <div class="site-nav__utility">
      <a class="navlink navlink--utility" href={languagePath} hreflang={language === "de" ? "en" : "de"}>{language === "de" ? "EN" : "DE"}</a>
    </div>
    <button class="site-nav__toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="nav-drawer">
      <span data-nav-label>{language === "de" ? "Menü" : "Menu"}</span>
    </button>
  </div>
  <div class="site-nav__drawerwrap" data-surface="ink">
    <div class="shell">
      <nav class="site-nav__drawer" id="nav-drawer" hidden aria-label={language === "de" ? "Alle Bereiche" : "All sections"}>
        {sections.map(([href, label]) => <a href={href}>{label}</a>)}
        <a href={languagePath} hreflang={language === "de" ? "en" : "de"}>{language === "de" ? "English" : "Deutsch"}</a>
        <a href="/about/">{language === "de" ? "Über PerlCoders" : "About"}</a>
        <a href="https://github.com/lia-xim/perlcoders.com" rel="noopener noreferrer">GitHub</a>
      </nav>
    </div>
  </div>
</header>
